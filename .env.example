# ─── AutoGTM environment ────────────────────────────────────────────────────
# Web app:  copy to apps/web/.env.local and fill in.
# Engine:   reads packages/email-engine/.env FIRST, then apps/web/.env.local,
#           and never overrides a value it already has. So keep the engine file
#           empty (or engine-only overrides), and never put an empty KEY= line
#           there: it hides the web value. Secrets like ENCRYPTION_KEY and
#           BETTER_AUTH_SECRET must be identical for web and engine.
#
# Scope: [web] Next.js app, [engine] packages/email-engine worker, [both].
# Because the engine falls back to apps/web/.env.local, putting every variable
# in apps/web/.env.local covers both processes.
# Lines that are commented out are optional; the value shown is the default.
# Do not leave optional numeric settings as empty strings (KEY=""): an empty
# string is not "unset" and e.g. ENGINE_INTERVAL_MS="" means 0 ms.
# Full reference: docs/OPERATIONS.md, "Environment variables".

# ── Required ────────────────────────────────────────────────────────────────

# [both] Postgres. Local: postgres://postgres:postgres@localhost:5432/autogtm
# Production: the "chadgtm" database. The deploy refuses to run if the web app,
# the worker (packages/email-engine/.env first) or migrations resolve a
# different database (scripts/check-deploy-env.mjs).
DATABASE_URL=""

# [both] Signs sessions and unsubscribe links. At least 32 random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# [both] Optional. After a ROUTINE rotation of BETTER_AUTH_SECRET, set this to
# the old value so unsubscribe links in emails already sent keep working (verify
# only; new links use BETTER_AUTH_SECRET). Anyone who knows this value can forge
# opt-outs, so NEVER set it to a leaked secret (such as the pre-rotation value
# in the repository history). See docs/OPERATIONS.md, "Secret rotation".
# UNSUBSCRIBE_SECRET_PREVIOUS=""

# [both] Encrypts mailbox SMTP/IMAP passwords and AI keys at rest. 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it in place: rotate with scripts/rotate-encryption-key.ts.
ENCRYPTION_KEY=""

# [both] Public https origin, e.g. https://autogtm.tech (local: http://localhost:3000).
# The engine uses it for tracking, unsubscribe and "Needs you" links, so it must
# be the real public URL in production.
APP_URL=""
# [web] Better Auth base URL; normally the same as APP_URL.
BETTER_AUTH_URL=""

# [web] Bearer token for GET/POST /api/engine/tick. Required in production
# (the route is disabled without it). The PM2 worker does not use the route.
CRON_SECRET=""

# ── Accounts and admin ──────────────────────────────────────────────────────

# [web] Comma-separated emails treated as admins once the address is VERIFIED
# (in addition to users.role = 'admin', the main mechanism).
ADMIN_EMAILS=""
# ADMIN_EMAIL is no longer read: give admins users.role = 'admin' instead.
# [web] New sign-ups must be approved by an admin before they can send.
# SIGNUP_APPROVAL_REQUIRED="true"
# [web] Extra origins allowed to sign in, comma-separated (e.g. an old domain).
# BETTER_AUTH_TRUSTED_ORIGINS="https://chadgtm.130-61-146-177.sslip.io"
# [web, browser] Origin used by the auth client; falls back to BETTER_AUTH_URL.
# NEXT_PUBLIC_APP_URL=""

# ── AI (optional; without a key research and triage use heuristics) ─────────

# [both] Google Gemini key (GOOGLE_API_KEY is accepted as an alias).
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""
# [both] OpenAI key, used when a workspace selects OpenAI.
# OPENAI_API_KEY=""
# [web] "false" falls back to the legacy direct analysis path without agent traces.
# AGENT_RUNTIME_ENABLED="true"

# ── Autopilot ───────────────────────────────────────────────────────────────

# [both] Countries autopilot targets, comma-separated.
# AUTOPILOT_COUNTRIES="United States"
# [both] Time zone for autopilot send windows.
# AUTOPILOT_TIMEZONE="America/New_York"

# ── System notification mail ("Your agent needs you", approvals) ────────────
# A dedicated sender for platform mail, separate from the cold-outreach pool.

# SYSTEM_SMTP_HOST=""
# SYSTEM_SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" for STARTTLS (587). Certificates are always verified.
# SYSTEM_SMTP_SECURE="false"
# SYSTEM_SMTP_USER=""
# SYSTEM_SMTP_PASS=""
# SYSTEM_EMAIL_FROM="AutoGTM <notify@autogtm.tech>"

# ── Engine ──────────────────────────────────────────────────────────────────

# [both] "1"/"true" = dry-run queue: nothing is sent. Unset = LIVE sending.
# The web app and the worker must agree. Set it in local development.
# ENGINE_DRY_RUN="1"
# [engine] Scheduler tick (ms). IMAP reply sync runs every 4th tick (every
# 2 min at the default). ENGINE_SYNC_MS is no longer read.
# ENGINE_INTERVAL_MS="30000"
# [engine] Emails processed per tick.
# ENGINE_BATCH_SIZE="25"
# [engine] Accept self-signed SMTP certificates. Avoid: fix the mail host's
# certificate instead.
# SMTP_ALLOW_SELF_SIGNED="false"

# ── Crawler ─────────────────────────────────────────────────────────────────

# [web] Chromium for JavaScript-rendered sites. On the VM run
# scripts/setup-oracle-browser.sh and paste the path it prints.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"
# CHROME_PATH=""

# ── Hosting (rarely needed) ─────────────────────────────────────────────────

# [web] Port for `next start` (PM2 passes -p 3005 in production).
# PORT="3000"
# [web] Build output directory (used by `npm run build:isolated`).
# NEXT_DIST_DIR=".next"
